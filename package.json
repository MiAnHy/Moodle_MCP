{
  "name": "moodle-mcp",
  "version": "1.0.0",
  "description": "Universal Moodle Model Context Protocol (MCP) Server",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "moodle-mcp": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "start": "node ./dist/cli/index.js",
    "start:sse": "node ./dist/cli/index.js --transport=sse --port=3000"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "turndown": "^7.2.5",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.68.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "mcp",
    "moodle",
    "lms",
    "model-context-protocol",
    "llm",
    "agent"
  ],
  "author": "",
  "license": "ISC"
}
